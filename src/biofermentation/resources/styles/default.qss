/* Look and feel of the application.
 *
 * Qt Style Sheets are CSS for widgets. This file can be edited without
 * touching a line of Python — change a colour, restart, done. Put your own
 * copy next to the database as style.qss and it is used instead; see
 * gui/style.py.
 *
 * The selectors are widget classes and object names. Object names are set in
 * the window code with setObjectName(), and the ones worth styling are:
 *   #runButton      the big Run/Pause button
 *   #phasePanel     one panel of the Process Manager
 *   #controlPanel   one controller panel of the Control Options tab
 */

QGroupBox {
    font-weight: bold;
    border: 1px solid #b4b4b4;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 6px;
}

QPushButton {
    padding: 4px 10px;
    border: 1px solid #adadad;
    border-radius: 3px;
    background: #f0f0f0;
}

QPushButton:hover:enabled {
    background: #e3efff;
    border-color: #6ba4e0;
}

QPushButton:disabled {
    color: #9a9a9a;
    background: #f6f6f6;
}

/* A checkable button — Inoculate — must look pressed when it is. Styling
 * QPushButton at all takes the native macOS rendering away, and with it the
 * only thing that showed the checked state. Same trap as the QComboBox popup
 * below. */
QPushButton:checked {
    background: #2f7fd1;
    border-color: #1d63a8;
    color: white;
    font-weight: bold;
}

QPushButton:checked:hover:enabled {
    background: #3b8ee0;
    border-color: #1d63a8;
}

QPushButton:pressed {
    background: #d8d8d8;
}

QPushButton#runButton {
    font-size: 16px;
    font-weight: bold;
}

QLineEdit[readOnly="true"] {
    background: #f4f4f4;
    color: #303030;
}

/* Styling a QComboBox at all switches macOS off the native rendering, and
 * the popup then comes up without a selection colour — the current entry is
 * white on white and the list looks empty. The popup has to be styled too. */
QComboBox QAbstractItemView {
    background: white;
    color: #202020;
    border: 1px solid #adadad;
    selection-background-color: #2f7fd1;
    selection-color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 2px 6px;
}

QComboBox::drop-down {
    width: 18px;
    border-left: 1px solid #c8c8c8;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    padding: 2px 4px;
    border: 1px solid #b4b4b4;
    border-radius: 3px;
    background: white;
}

QDoubleSpinBox:disabled, QSpinBox:disabled, QLineEdit:disabled {
    background: #ededed;
    color: #9a9a9a;
}

QTableView {
    gridline-color: #d8d8d8;
    selection-background-color: #2f7fd1;
    selection-color: white;
}

QHeaderView::section {
    padding: 4px;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #b4b4b4;
    background: #f2f2f2;
    font-weight: bold;
}

/* The page is white, like the active tab above it — the two read as one
 * sheet of paper rather than a grey box under a white flap. */
QTabWidget::pane {
    border: 1px solid #b4b4b4;
    border-radius: 3px;
    top: -1px;
    background: white;
}

/* The pages themselves. #tabPage is set in control_app._style_tab_pages,
 * which also lets a plain QWidget draw a styled background at all. */
QWidget#tabPage {
    background: white;
}

QScrollArea#tabPage {
    border: none;
}

/* QGroupBox on white needs no ground of its own, only its frame. */
QTabWidget QGroupBox {
    background: transparent;
}

QTabBar::tab {
    padding: 7px 18px;
    margin-right: 2px;
    border: 1px solid #c0c0c0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background: #e8e8e8;
    color: #4a4a4a;
}

QTabBar::tab:hover:!selected {
    background: #f0f0f0;
}

QTabBar::tab:selected {
    background: white;
    color: #1a1a1a;
    font-weight: bold;
    /* One pixel over the pane border, so the active tab joins the page. */
    margin-bottom: -1px;
    padding-bottom: 8px;
}

/* The log tab reads like a terminal: dark ground, fixed pitch, no frame
   competing with the tab pane around it. */
QTextEdit#logTerminal {
    background: #1e1f22;
    color: #d6d6d6;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    padding: 6px;
    selection-background-color: #2f7fd1;
}
